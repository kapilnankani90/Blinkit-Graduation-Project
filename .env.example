# ==========================================
# LLM (Large Language Model) API Credentials
# ==========================================
# Google Gemini 1.5 / 2.0 Flash API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here

# Optional: Groq LLM API Key (for Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# Railway Backend Service Endpoint
# ==========================================
# Used by Vercel frontend to proxy API requests to your live Railway backend server.
# Replace with your generated Railway backend URL (e.g. https://your-backend.up.railway.app)
VITE_API_BASE_URL=https://blinkit-backend-production.up.railway.app

# ==========================================
# Database & Redis Queue (Railway Production)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/blinkit_discovery
REDIS_URL=redis://localhost:6379/0
